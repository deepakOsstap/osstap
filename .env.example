# Email Configuration (Nodemailer with Gmail SMTP)
# 1. Receiver Email: The destination where enquiry emails will be sent
CONTACT_RECEIVER_EMAIL=d.choudhary@osstap.com

# 2. Sender Gmail Address (your Gmail address)
SMTP_USER=d.choudhary@osstap.com

# 3. Google App Password (16-character password generated from Google Account Security)
# How to get it:
# 1. Go to https://myaccount.google.com/security
# 2. Ensure "2-Step Verification" is ON
# 3. Search for "App passwords" in the top search bar
# 4. Create an App password named "Osstap Website"
# 5. Copy the generated 16-character password and paste it here (without spaces)
SMTP_PASS=your-16-character-app-password

# Optional SMTP Settings (defaults to smtp.gmail.com:465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
